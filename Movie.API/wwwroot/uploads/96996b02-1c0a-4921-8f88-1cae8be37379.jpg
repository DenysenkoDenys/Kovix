  $('td.none a.subscribe').on('click', function(e) {
    var item_type = $(this).attr('data-type');
    var item_id = $(this).attr('data-id');

    $.ajax({
      url: '/notifications/subscribe_to_group',
      type: 'PUT',
      data: {
        media_type: item_type,
        media_id: item_id
      }
    }).fail(function() {
      showError('Виникла проблема. ');
    }).done(function(response) {

      if (response.failure) {
        showError('Виникла проблема. ');
      }

      if (response.success) {
        showSuccess('Subscribed', 'Успіх');
        $('td.none p.notify').toggleClass('hide');
      }

    });
  });

  $('td.none a.unsubscribe').on('click', function(e) {
    var item_type = $(this).attr('data-type');
    var item_id = $(this).attr('data-id');

    $.ajax({
      url: '/notifications/subscribe_to_group',
      type: 'DELETE',
      data: {
        media_type: item_type,
        media_id: item_id
      }
    }).fail(function() {
      showError('Виникла проблема. ');
    }).done(function(response) {

      if (response.failure) {
        showError('Виникла проблема. ');
      }

      if (response.success) {
        showSuccess('Unsubscribed', 'Успіх');
        $('td.none p.notify').toggleClass('hide');
      }

    });
  });
</script>

